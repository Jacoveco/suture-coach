# Server-only secret — never commit the real value, never expose to the client (no NEXT_PUBLIC_ prefix)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the default analysis model (see lib/analysis/analyzeSuture.ts)
# ANALYSIS_MODEL=claude-opus-5

# "true" bypasses the real Claude API and returns fixture data instead.
# "npm run dev" always forces this to true regardless of this file (see
# package.json); only "npm run dev:real" forces it to false. This line is
# belt-and-suspenders for if next dev/start is ever run directly.
USE_FAKE_ANALYSIS=true

# Optional: max upload size in MB, enforced client- and server-side. Kept
# modest by default since it's a direct lever on Claude API cost per request.
# MAX_UPLOAD_SIZE_MB=10
