# Server-only secret — never commit the real value, never expose to the client (no NEXT_PUBLIC_ prefix)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the default analysis model (see lib/analysis/analyzeSuture.ts)
# ANALYSIS_MODEL=claude-opus-5

# Optional: "true" bypasses the real Claude API and returns fixture data.
# Used by e2e tests and local dev to avoid burning API credits.
# USE_FAKE_ANALYSIS=false

# Optional: max upload size in MB, enforced client- and server-side
# MAX_UPLOAD_SIZE_MB=25
